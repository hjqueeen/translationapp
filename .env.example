# LiveKit — Cloud: https://cloud.livekit.io
# Or local: docker compose up -d  (defaults below match docker-compose.yml)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# OpenAI (required for STT / translation / TTS)
OPENAI_API_KEY=

# API + agent
PORT=8787
API_URL=http://127.0.0.1:8787
AGENT_PORT=8790
AGENT_DISPATCH_URL=http://127.0.0.1:8790/dispatch

# Next.js web app
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
